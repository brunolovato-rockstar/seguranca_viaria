# ---------- Servidor ----------
PORT=3001
# Troque por um valor longo e aleatório
JWT_SECRET=troque-este-segredo
# Chave para criptografar a senha das câmeras no banco (32+ caracteres)
CRYPTO_KEY=troque-esta-chave-de-32-caracteres-ou-mais
# Pasta onde ficam as imagens dos eventos
STORAGE_DIR=./storage

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=seguranca_viaria

# ---------- Usuário inicial (criado pelo db:init) ----------
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# ---------- Câmera da rua via túnel (criada pelo db:init como CAM-01) ----------
# O túnel aponta para a porta 80 da câmera
CAM1_URL=http://localhost:63519
CAM1_USER=admin
CAM1_PASSWORD=
CAM1_NOME=Câmera da rua (túnel)

# ---------- Eventos ----------
# Lista de eventos pedida à câmera no HTTP API ([All] = todos)
CAMERA_EVENTS=[All]
# Intervalo mínimo entre snapshots por câmera (ms) — protege a câmera com vários usuários olhando
SNAPSHOT_MIN_INTERVAL_MS=300

# ---------- Vídeo ao vivo (RTSP -> navegador via go2rtc) ----------
# go2rtc rodando nesta máquina (porta da API/web dele)
GO2RTC_URL=http://localhost:1984
# RTSP da CAM-01 SEM usuário/senha (o servidor injeta). Precisa de túnel para a porta 554 da câmera.
# Ex.: túnel 554 -> localhost:63554
CAM1_RTSP_URL=rtsp://localhost:63554/cam/realmonitor?channel=1&subtype=0

# Localização da CAM-01 no mapa (gravada pelo npm run db:init)
CAM1_LAT=-25.527786171922187
CAM1_LNG=-49.196405138055646

# ---------- Mapa (Mapbox) ----------
# Chave pública do Mapbox (começa com pk.)
MAPBOX_TOKEN=
# Opcional: estilo próprio (mapbox://styles/usuario/estilo). Vazio = ruas/satélite e dia/noite automáticos
MAPBOX_STYLE=

# ---------- Manutenção pela tela (Diagnóstico → Sistema e log) ----------
# Linux com systemd: 1 libera o botão "Reiniciar servidor" (o serviço sobe de novo sozinho)
RESTART_BY_EXIT=
# Comando para reiniciar a VPN (ex.: sudo -n /usr/bin/systemctl restart openvpn-client@pumatronix). Vazio = botão desligado
VPN_RESTART_CMD=
# Comando que mostra o estado da VPN (ex.: systemctl is-active openvpn-client@pumatronix)
VPN_STATUS_CMD=
